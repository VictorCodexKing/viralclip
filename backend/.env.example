# ViralClip backend configuration.
# Copy this file to `.env` (in the backend/ directory) and fill in your keys.
# All values are read at startup via python-dotenv (see app/config.py).

# --- LLM (AI clip selection) ------------------------------------------------
# At least one LLM provider key is required. Gemini is the default provider.
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Model id used for clip selection. Format is provider:model.
# Default: google-gla:gemini-1.5-flash
# Other examples: openai:gpt-4o-mini, anthropic:claude-3-5-sonnet-latest, ollama:llama3
LLM=google-gla:gemini-1.5-flash

# Optional alternative LLM providers (set the matching key and point LLM at it).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Base URL for a local Ollama server (default http://localhost:11434/v1).
OLLAMA_BASE_URL=

# --- Transcription ----------------------------------------------------------
# Which transcription backend to use: whisper | assemblyai | youtube_captions
# Default: whisper (fully local, no API key needed).
TRANSCRIPTION_PROVIDER=whisper

# Local Whisper model size (tiny | base | small | medium | large).
# Default: base. Weights download automatically on first run.
WHISPER_MODEL=base

# Optional: use AssemblyAI for word-level transcription instead of local Whisper.
# Set TRANSCRIPTION_PROVIDER=assemblyai to enable. Get a key at https://www.assemblyai.com/
ASSEMBLY_AI_API_KEY=

# --- B-roll (optional) ------------------------------------------------------
# Enables optional Pexels stock-footage overlays. Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Clipping limits (optional) --------------------------------------------
# MAX_CLIPS=7
# CLIP_DURATION=30
# MAX_VIDEO_DURATION=5400

# --- Filesystem (optional) --------------------------------------------------
# OUTPUT_DIR=data/outputs
# TEMP_DIR=data/temp

# --- HTTP / CORS (optional) -------------------------------------------------
# Comma-separated list of allowed frontend origins.
# CORS_ORIGINS=http://localhost:3000

# ViralClip top-level environment reference.
#
# ViralClip has two apps, each with its own .env file:
#   - backend/.env   (Python / FastAPI)  -> see backend/.env.example
#   - frontend/.env  (Next.js)           -> the single NEXT_PUBLIC_API_URL below
#
# This file documents every variable in one place. Copy the relevant lines into
# backend/.env and frontend/.env, or copy each app's own .env.example.

# ============================================================================
# BACKEND (copy into backend/.env)
# ============================================================================

# --- LLM (AI clip selection) ---
# Required: at least one LLM provider key. Gemini is the default.
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: model id, format provider:model. Default google-gla:gemini-1.5-flash.
# Examples: openai:gpt-4o-mini, anthropic:claude-3-5-sonnet-latest, ollama:llama3
LLM=google-gla:gemini-1.5-flash

# Optional alternative LLM providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# --- Transcription ---
# Optional: whisper (default, local) | assemblyai | youtube_captions
TRANSCRIPTION_PROVIDER=whisper
# Optional: local Whisper model size. Default base.
WHISPER_MODEL=base
# Optional: use AssemblyAI word-level transcription instead of local Whisper.
ASSEMBLY_AI_API_KEY=

# --- B-roll ---
# Optional: enables Pexels stock-footage overlays.
PEXELS_API_KEY=

# ============================================================================
# FRONTEND (copy into frontend/.env)
# ============================================================================

# Base URL the browser uses to reach the backend API. Default http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
